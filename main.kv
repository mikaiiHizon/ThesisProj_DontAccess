#:import dp kivy.metrics.dp

ScreenManager:

    HomeScreen:
    ChatScreen:
    AddScreen:
    ListScreen:


# ================= HOME =================
<HomeScreen>:
    name: "home"

    FloatLayout:

        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            md_bg_color: 0.95, 0.95, 0.95, 1

            # ================= TOP BAR =================
            MDTopAppBar:
                title: "AgriGabay AI"
                md_bg_color: 0.1, 0.4, 0.1, 1
                elevation: 3
                right_action_items: [["weather-cloudy", lambda x: root.update_weather()]]

            # ================= CONTENT =================
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(15), dp(10), dp(15), dp(85)  # bottom space for nav
                spacing: dp(15)

                # ✅ WEATHER CARD (NOW CLEANLY AT TOP)
                MDCard:
                    radius: [20]
                    padding: dp(15)
                    size_hint_y: None
                    height: dp(130)
                    elevation: 4
                    md_bg_color: 1, 1, 1, 1

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)

                        MDIcon:
                            id: weather_icon
                            icon: "weather-partly-cloudy"
                            font_size: "42sp"
                            theme_text_color: "Custom"
                            text_color: 0.1, 0.4, 0.1, 1
                            size_hint_x: None
                            width: dp(60)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(5)

                            MDLabel:
                                text: "PANAHON NGAYON"
                                theme_text_color: "Hint"
                                font_style: "Caption"

                            MDLabel:
                                id: weather_info
                                text: "Tap cloud icon to sync"
                                font_style: "H6"
                                bold: True

        # ================= BOTTOM NAV =================
        MDBoxLayout:
            size_hint: 1, None
            height: dp(70)
            pos_hint: {"x": 0, "y": 0}
            md_bg_color: 1, 1, 1, 0.95
            padding: dp(40), 0

            MDIconButton:
                icon: "format-list-bulleted"
                on_release: app.change_screen("list")

            Widget:

            MDIconButton:
                icon: "chat-outline"
                on_release: app.change_screen("chat")

        # ================= FLOATING BUTTON =================
        MDFloatingActionButton:
            icon: "plus"
            pos_hint: {"center_x": 0.5, "y": 0.035}
            size_hint: None, None
            size: "70dp", "70dp"
            md_bg_color: 0.1, 0.4, 0.1, 1
            elevation_normal: 12
            on_release: app.change_screen("add")


# ================= CHAT =================
<ChatScreen>:
    name: "chat"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.97, 0.97, 0.97, 1

        MDTopAppBar:
            title: "Agri AI Chat"
            md_bg_color: 0.1, 0.4, 0.1, 1
            left_action_items: [["arrow-left", lambda x: app.change_screen("home")]]

        ScrollView:
            id: scroll_view

            MDBoxLayout:
                id: chat_box
                orientation: "vertical"
                adaptive_height: True
                padding: dp(10)
                spacing: dp(8)


        MDBoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(10)
            spacing: dp(10)

            MDTextField:
                id: user_input
                hint_text: "Ask AI about crops..."

            MDRaisedButton:
                text: "Send"
                md_bg_color: 0.1, 0.4, 0.1, 1
                on_release: root.send_message()


# ================= ADD =================
<AddScreen>:
    name: "add"

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Add Crop"
            md_bg_color: 0.1, 0.4, 0.1, 1
            left_action_items: [["arrow-left", lambda x: app.change_screen("home")]]

        MDBoxLayout:
            padding: dp(20)

            MDTextField:
                hint_text: "Crop Name"

        MDRaisedButton:
            text: "Save"
            md_bg_color: 0.1, 0.4, 0.1, 1


# ================= LIST =================
<ListScreen>:
    name: "list"

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Crop List"
            md_bg_color: 0.1, 0.4, 0.1, 1
            left_action_items: [["arrow-left", lambda x: app.change_screen("home")]]

        MDLabel:
            text: "No crops yet"
            halign: "center"
            theme_text_color: "Hint"