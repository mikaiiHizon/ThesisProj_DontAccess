MDBoxLayout:
    orientation: 'vertical'
    md_bg_color: 0.95, 0.95, 0.95, 1

    MDTopAppBar:
        title: "San Marcelino, AgriGabay"
        elevation: 4
        md_bg_color: 0.1, 0.4, 0.1, 1
        right_action_items: [["weather-cloudy", lambda x: app.update_weather()]] 

    ScrollView:
        size_hint_y: 1
        MDBoxLayout:
            orientation: 'vertical'
            adaptive_height: True
            padding: "16dp"
            spacing: "15dp"

            # Weather Display Card - Enhanced for Forecast
            MDCard:
                size_hint: 1, None
                height: "420dp"
                padding: "15dp"
                radius: [15, ]
                orientation: 'vertical'
                MDLabel:
                    text: "3-DAY WEATHER FORECAST"
                    font_style: "H6"
                    bold: True
                    halign: "center"
                MDLabel:
                    id: current_weather
                    text: "Tap cloud to sync"
                    font_style: "Body1"
                    halign: "center"
                    theme_text_color: "Primary"
                MDExpansionPanelList:
                    id: weather_panels
                    orientation: 'vertical'
                    adaptive_height: True
                WeatherDay@MDExpansionPanel:
                    radius: [10,]
                <WeatherDay>:
                    title: day_date + " - " + day_summary
                    content: 
                        orientation: 'vertical'
                        padding: "10dp"
                        spacing: "5dp"
                        MDLabel:
                            id: day_date
                            text: "Today"
                        MDLabel:
                            id: day_summary
                            text: "Sunny 28°C avg"
                        ScrollView:
                            size_hint: 1, None
                            height: "80dp"
                            MDBoxLayout:
                                orientation: 'horizontal'
                                adaptive_height: True
                                spacing: "5dp"
                                HourlyChip@MDChip:
                                <HourlyChip>:
                                    text: hour_time + "\\n" + str(hour_temp) + "°"
                                    icon: app.get_weather_icon('Clear')

            # NPK Inputs Card
            MDCard:
                orientation: 'vertical'
                adaptive_height: True
                padding: "20dp"
                spacing: "10dp"
                radius: [15, ]
                
                MDLabel:
                    text: "Soil Input"
                    bold: True

                MDTextField:
                    id: n_input
                    hint_text: "Nitrogen 👎"
                    mode: "fill"

                MDTextField:
                    id: ph_input
                    hint_text: "pH Level"
                    mode: "fill"

                MDRaisedButton:
                    text: "PREDICT CROP"
                    md_bg_color: 0.1, 0.4, 0.1, 1
                    size_hint_x: 1
                    on_release: app.run_prediction()

            MDLabel:
                id: result_label
                text: "---"
                halign: "center"
                font_style: "H5"
    
    MDBoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "80dp"
        spacing: "12dp"
        padding: "12dp"

        MDFlatButton:
            text: "Home"
            theme_text_color: "Custom"
            text_color: 0.1, 0.4, 0.1, 1
            size_hint: 0.4, 1

        MDIconButton:
            icon: "plus"
            md_bg_color: 0.1, 0.4, 0.1, 1
            theme_icon_color: "Custom"
            icon_color: 1, 1, 1, 1
            size_hint: 0.2, 1
            elevation_normal: 4
            radius: [100, ]

        MDFlatButton:
            text: "Task"
            theme_text_color: "Custom"
            text_color: 0.1, 0.4, 0.1, 1
            size_hint: 0.4, 1

